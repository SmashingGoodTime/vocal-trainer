# Build output
build/
build-debug/
out/
.vs/

# JUCE is a plain directory clone, not a submodule — never commit it
JUCE/

# Python
.venv/
# Stage 0 lives in its own venv because audio-separator needs torch and the
# analysis venv must stay ONNX-only. ~3 GB — definitely not in git.
.venv-separate/
__pycache__/
*.pyc
*.egg-info/

# Song material and analysis caches — never commit copyrighted audio, and never
# commit charts derived from it either: the aligned lyrics are a derivative work.
#
# songs/synth-demo is the one exception. It is synthesised test audio generated by
# this project, it carries no third-party rights, and it is what makes a fresh
# clone playable — and what stops vt_chart_tests silently skipping its checks.
songs/*
!songs/synth-demo/
songs/synth-demo/cache/

cache/
*.wav
*.mp3

# ...but the demo's audio has to survive the blanket *.wav rule above.
!songs/synth-demo/backing.wav
!songs/synth-demo/stems/vocals.wav
